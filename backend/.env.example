PROJECT_NAME="KedaiKas"
SECRET_KEY="ganti-dengan-secret-key-aman-anda"

# --- Pilihan Database ---
# PostgreSQL 18 (production/development dengan PostgreSQL):
DATABASE_URL="postgresql+psycopg://postgres:PASSWORD@localhost:5432/project_warung"
# MariaDB/MySQL (development dengan XAMPP):
# DATABASE_URL="mysql+pymysql://root:@localhost:3306/project_warung"

# USE_MOCK_REPO=false  → gunakan database nyata (PostgreSQL atau MariaDB)
# USE_MOCK_REPO=true   → gunakan MockRepository in-memory (tidak butuh database)
USE_MOCK_REPO=true
